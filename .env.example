# Copy this file to .env and fill in your Supabase project's values.
# Find both in your Supabase project: Settings -> API.
# The anon key is safe to expose client-side — it's the public key, and
# Row Level Security policies (see supabase/schema.sql) control access.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
